CONTEXT7_API_KEY=Dein-Context7-key
# Local development
# Next.js default development port: 3000

# Planned infrastructure
# PostgreSQL default port: 5432
# Game
# Host name shown on the overlay ("Louis picked…"). 1–32 characters, falls back to "Host".
HOST_DISPLAY_NAME=Host

# Twitch chat voting (Decision 046)
# Register an app at https://dev.twitch.tv/console and copy its Client ID and secret.
# The OAuth Redirect URL registered there must match TWITCH_REDIRECT_URI exactly.
# OAuth tokens are never configured here: the host connects on /host and tokens stay in server memory.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/auth/callback
